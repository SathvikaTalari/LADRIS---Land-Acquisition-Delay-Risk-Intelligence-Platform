# =============================================================================
# LandPulse AI — Environment Configuration Template
# Copy this file to .env and fill in your values before running.
# NEVER commit the real .env file to version control.
# =============================================================================

# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=LandPulse AI
APP_VERSION=0.1.0

# ─── PostgreSQL / PostGIS (Docker DB running on localhost:15432) ────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=ladris
POSTGRES_USER=ladris_user
POSTGRES_PASSWORD=landpulse_pass

# Full DSN
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
# Sync DSN
SYNC_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ─── JWT Authentication ───────────────────────────────────────────────────────
JWT_SECRET_KEY=01fd109a6c2887b1253cf7d8d77b4a1149f1bfeb38a22750ef7b137b4d5aa060
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Security ─────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
BCRYPT_ROUNDS=12

# ─── Backend Server ───────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=LandPulse AI
VITE_APP_VERSION=0.1.0
VITE_MAP_STYLE=https://demotiles.maplibre.org/style.json

# ─── First Admin User (created on first startup) ──────────────────────────────
FIRST_ADMIN_EMAIL=admin@landpulse.gov.in
FIRST_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
FIRST_ADMIN_NAME=System Administrator

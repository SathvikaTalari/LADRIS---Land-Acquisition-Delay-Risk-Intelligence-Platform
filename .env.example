# =============================================================================
# LandPulse AI — Environment Configuration Template
# Copy this file to .env and fill in your values before running.
# NEVER commit the real .env file to version control.
# =============================================================================

# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=LandPulse AI
APP_VERSION=0.1.0

# ─── PostgreSQL / PostGIS ─────────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=landpulse
POSTGRES_USER=landpulse_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Full DSN (auto-composed in docker-compose; override for external DB)
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
# Sync DSN for Alembic migrations
SYNC_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_64
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Security ─────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
BCRYPT_ROUNDS=12

# ─── Backend Server ───────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=LandPulse AI
VITE_APP_VERSION=0.1.0
VITE_MAP_STYLE=https://demotiles.maplibre.org/style.json

# ─── First Admin User (created on first startup) ──────────────────────────────
FIRST_ADMIN_EMAIL=admin@landpulse.gov.in
FIRST_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
FIRST_ADMIN_NAME=System Administrator

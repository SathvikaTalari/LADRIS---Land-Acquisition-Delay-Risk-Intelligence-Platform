# =============================================================================
# LandPulse AI — .gitignore
# =============================================================================

# Environment files — NEVER commit real secrets
.env
.env.local
.env.*.local
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-log.txt
pip-delete-this-directory.txt
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
*.pyo
*.pyd
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/

# Alembic
backend/alembic/versions/*.pyc

# Node.js / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Docker volumes (local overrides)
pgdata/

# ML data — raw/real government data must NOT be committed without approval
ml/data/raw/**/*.csv
ml/data/raw/**/*.json
ml/data/raw/**/*.xlsx
ml/data/raw/**/*.zip
ml/data/raw/**/*.parquet
!ml/data/raw/.gitkeep
ml/data/processed/**/*.csv
ml/data/processed/**/*.parquet
!ml/data/processed/.gitkeep
ml/data/features/**
!ml/data/features/.gitkeep
ml/models/*.pkl
ml/models/*.joblib
ml/models/*.pt
ml/models/*.h5
!ml/models/.gitkeep

# Jupyter
ml/notebooks/.ipynb_checkpoints/
*.ipynb_checkpoints/

# Logs
*.log
logs/
backend/logs/

# OS
.DS_Store
Thumbs.db
